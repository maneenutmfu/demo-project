// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลสำหรับสัปดาห์ที่ 6
//
// ⚠️ ยังไม่มีล็อกอินในระบบ (ตามสเปกสัปดาห์ที่ 6) จึงเปิดอ่าน/เขียนแบบไม่ต้อง
// ยืนยันตัวตนไปก่อน — ต้องเปลี่ยนเป็นกฎที่รัดกุมขึ้นในสัปดาห์ที่ 7-8
// เมื่อระบบมีการล็อกอินและแยกสิทธิ์ตามบทบาทแล้ว
//
// วิธีใช้: คัดลอกเนื้อหาไฟล์นี้ไปวางที่ Firebase Console →
// Firestore Database → กฎ (Rules) → Publish
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
