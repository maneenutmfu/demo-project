// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลสำหรับสัปดาห์ที่ 7
//
// กฎขั้นต่ำ: ต้องล็อกอินก่อน ถึงจะอ่าน/เขียนได้ (ยังไม่แยกสิทธิ์ตามคน/บทบาท
// — กฎรายห้องที่ละเอียดกว่านี้เป็นงานของสัปดาห์ที่ 8)
//
// วิธีใช้: คัดลอกเนื้อหาไฟล์นี้ไปวางที่ Firebase Console →
// Firestore Database → กฎ (Rules) → Publish
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
